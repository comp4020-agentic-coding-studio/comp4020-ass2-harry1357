---
import { getPublishedCollection } from "astro-course-university/content";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import { formatCourseDate } from "../../lib/dates";
import { sessionLabels, siteConfig } from "../../site-config";

// One line per week: date, claim, object. A reader deciding whether to take
// this wants the shape of the semester on one screen, not twelve summaries —
// so the descriptions stay on the week pages and this stays a list.
const weeks = (await getPublishedCollection("sessions"))
  .map((session) => ({
    id: session.id,
    week: session.data.week,
    date: session.data.date,
    title: session.data.title,
    object: typeof session.data.object === "string" ? session.data.object : "",
  }))
  .sort((a, b) => a.week - b.week);
---

<ContentLayout
  title={sessionLabels.plural}
  description={`Twelve weeks: the date, the week's claim, and the one thing it studies.`}
  {...siteConfig}
>
  <ol class="schedule">
    {
      weeks.map((week) => (
        <li>
          <span class="schedule-week">{week.week}</span>
          <time class="schedule-date" datetime={week.date.toISOString().slice(0, 10)}>
            {formatCourseDate(week.date)}
          </time>
          <a class="schedule-title" href={withBase(`/sessions/${week.id}/`)}>
            {week.title}
          </a>
          <span class="schedule-object">{week.object}</span>
        </li>
      ))
    }
  </ol>
</ContentLayout>

<style>
  .schedule {
    margin-block: 1.5rem 0;
    padding: 0;
    list-style: none;
  }

  .schedule li {
    display: grid;
    grid-template-columns: 2.25rem 9rem minmax(0, 1fr) 12rem;
    gap: 0 1rem;
    align-items: baseline;
    padding-block: 0.7rem;
    border-block-start: 1px solid var(--at-light-grey);
  }

  .schedule li:last-child {
    border-block-end: 1px solid var(--at-light-grey);
  }

  .schedule-week {
    color: var(--at-text-secondary);
    font-variant-numeric: tabular-nums;
    text-align: end;
  }

  .schedule-date {
    color: var(--at-text-secondary);
    font-size: 0.9rem;
  }

  .schedule-title {
    font-weight: 600;
  }

  .schedule-object {
    color: var(--at-text-secondary);
    font-size: 0.9rem;
  }

  @media (width <= 52rem) {
    .schedule li {
      grid-template-columns: 2.25rem minmax(0, 1fr);
      row-gap: 0.15rem;
    }

    .schedule-date {
      grid-column: 2;
      order: -1;
    }

    .schedule-title,
    .schedule-object {
      grid-column: 2;
    }
  }
</style>
